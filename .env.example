# Set these environment variables before starting; this file is documentation only.
FEEDBACK_DATABASE=data/feedback.sqlite3
FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=5000
# demo works offline; compatible uses a Chat Completions compatible service.
FEEDBACK_PROVIDER=demo
FEEDBACK_API_BASE=https://your-provider.example/v1
FEEDBACK_API_KEY=
FEEDBACK_MODEL=
FEEDBACK_TIMEOUT=60
# Optional provider prices per million tokens, in the same currency.
FEEDBACK_INPUT_PRICE=
FEEDBACK_OUTPUT_PRICE=
